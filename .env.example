# YKS Boost - Environment Variables Template
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/yks_boost

# API Keys
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
NODE_ENV=development

# Replit Configuration (automatically set on Replit)
# REPLIT_DEV_DOMAIN=your-replit-domain.repl.co
# REPLIT_DOMAINS=your-domains

# Expo Configuration
EXPO_PUBLIC_API_URL=http://localhost:8000
